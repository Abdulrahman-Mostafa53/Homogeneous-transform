<?xml version="1.0"?>

<robot name="car"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- set up the gazebo plugin dedicated to help us use sensors-->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name = "gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- define xacro properties for the wheels -->
  <xacro:property name="wheel_radius" value = "0.442"/>
  <xacro:property name="wheel_length" value = "0.45"/>

  <!-- a macro to setup wheels and their joints -->
  <xacro:macro name = "wheel_link" params= "prefix forward right shift">
    <link name="${prefix}_wheel">
      <visual>
        <geometry>
          <mesh filename = "package://robot_desc/meshes/wheel.glb"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy = "0 1.5707 0"/>
        <geometry>
          <cylinder length = "${wheel_length}" radius = "${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value = "30"/>
        <inertia ixx = "1.9715" iyy = "1.9715" izz = "2.9305" ixy = "0" ixz= "0" iyz = "0"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin rpy="0 0 ${1.5707*right}" xyz="${forward * 1.2 + shift} ${right * 1} 0.2"/>
      <axis xyz = "${1*right} 0 0"/>
    </joint>
  </xacro:macro>

  <!-- setup base footprint (i used it to solve a warning) -->
  <link name = "base_footprint" />

  <!-- base link of the car -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename = "package://robot_desc/meshes/car.glb"/>
      </geometry>
      <origin rpy = "1.5707 0 1.5707"/>
    </visual>
    <collision>
      <origin xyz = "0 0 0.8"/>
      <geometry>
        <box size = "4.6 2.3 1.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value = "1000"/>
      <inertia ixx = "560.8" iyy = "1883.3" izz = "2204" ixy = "0" ixz= "0" iyz = "0"/>
    </inertial>
  </link>

  <!-- the visual part of the camera -->
  <link name="camera_link">
    <visual>
      <geometry>
        <mesh filename = "package://robot_desc/meshes/camera.glb"/>
      </geometry>
      <origin rpy = "1.5707 0 1.5707"/>
    </visual>
    <collision>
      <geometry>
        <box size = "0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value = "0.2"/>
      <inertia ixx = "0.0001" iyy = "0.0001" izz = "0.0001" ixy = "0" ixz= "0" iyz = "0"/>
    </inertial>
  </link>

  <!-- the optical part (where the camera really sees the environment)-->
  <link name = "camera_link_optical">
    <inertial>
      <mass value = "0.001"/>
      <inertia ixx = "0.0001" iyy = "0.0001" izz = "0.0001" ixy = "0" ixz= "0" iyz = "0"/>
    </inertial>
  </link>

  <!-- link the car base link to the dummy root footprint-->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- link the camera to the car chasis-->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="1 0 1.2"/>
  </joint>

  <!-- link the optical part of the camera to the visual part -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0.2 0 0" rpy = "0 0 0"/>
  </joint>

  <!-- define the four wheels -->
  <xacro:wheel_link prefix = "front_right" forward = "1" right = "1" shift = "0.2"/>
  <xacro:wheel_link prefix = "front_left" forward = "1" right = "-1" shift = "0.2"/>
  <xacro:wheel_link prefix = "back_right" forward = "-1" right = "1" shift = "0"/>
  <xacro:wheel_link prefix = "back_left" forward = "-1" right = "-1" shift = "0"/>

  <!-- setup the gazebo motion plugin -->
  <gazebo>
    <plugin name = "gz::sim::systems::DiffDrive" filename = 'gz-sim-diff-drive-system'>
      <left_joint>back_left_joint</left_joint>
      <right_joint>back_right_joint</right_joint>
      <left_joint>front_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint>

      <wheel_separation>2</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <max_linear_acceleration>100.0</max_linear_acceleration>
      <max_angular_acceleration>1000.0</max_angular_acceleration>

      <topic>cmd_vel</topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_topic>odom</odom_topic>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>tf</tf_topic>
    </plugin>
  </gazebo>

  <!-- setup  the camera sensor -->
  <gazebo reference = "camera_link_optical">
    <sensor name="camera" type="camera">
      <topic>camera/image</topic>
      <camera_info_topic>camera/camera_info</camera_info_topic>
      <gz_frame_id>camera_link_optical</gz_frame_id>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>1980</width>
          <height>1020</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>50.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <stddev>0.055</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>        